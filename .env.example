# Database
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=JobifyDB
MARIADB_USERNAME=jobify
MARIADB_PASSWORD=CHANGE_ME_MARIADB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MARIADB_VERSION=10.6
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Docker ports
FRONTEND_PORT=8080
BACKEND_PORT=8081

# Public URLs
APP_URL=http://tu-dominio-o-ip
API_URL=http://tu-dominio-o-ip:8081
CORS_ORIGIN=http://tu-dominio-o-ip

# Backend integrations
# Full Cloudinary URL, e.g. cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Mercado Pago OAuth keys
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=

# Public URLs (legacy alias used by backend)
FRONTEND_URL=${APP_URL}

# AI keys
GOOGLE_API_KEY=
GROQ_API_KEY=

# 32-byte encryption key in hex (64 hex chars)
KEY_HEX=

# Frontend build variables (Vite)
VITE_API_URL=${API_URL}
VITE_MP_CLIENT_ID=
VITE_API_PROXY_TARGET=
