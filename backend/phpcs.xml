<?xml version="1.0"?>
<ruleset name="Jobify">
    <description>Configuración de PHP_CodeSniffer para Jobify</description>

    <!-- Archivos y directorios a verificar -->
    <file>src</file>
    <file>index.php</file>

    <!-- Archivos a excluir -->
    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>
    <exclude-pattern>*.min.css</exclude-pattern>

    <!-- Usar estándar PSR-12 -->
    <rule ref="PSR12"/>

    <!-- Configuraciones adicionales -->
    <arg name="colors"/>
    <arg value="p"/>
    <arg value="s"/>
    <arg name="parallel" value="75"/>

    <!-- Configurar tab width -->
    <arg name="tab-width" value="2"/>


    <!-- Extensiones de archivos a verificar -->
    <arg name="extensions" value="php"/>

    <!-- Configuraciones específicas para tu proyecto -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="150"/>
        </properties>
    </rule>

    <!-- Permitir arrays con índices no alineados -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    
    <!-- Configurar indentación -->
    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <properties>
            <property name="indent" value="2"/>
            <property name="tabIndent" value="false"/>
        </properties>
    </rule>
</ruleset>
